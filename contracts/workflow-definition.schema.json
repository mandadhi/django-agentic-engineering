{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.techwave.com/django-agentic-engineering/contracts/workflow-definition.schema.json",
  "title": "WorkflowDefinition",
  "description": "A versioned DAG of stages. Discovered from the workflows/ directory configured in workflow-config.yaml.",
  "type": "object",
  "required": ["schema_version", "kind", "id", "version", "stages"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "kind": { "const": "WorkflowDefinition" },
    "id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this definition, recorded on every execution."
    },
    "status": { "enum": ["draft", "active", "deprecated"], "default": "draft" },
    "inputs": {
      "type": "object",
      "description": "JSON Schema for the inputs an execution of this workflow accepts."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "workflow-stage.schema.json" }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/Extensions" }
  }
}
